[Unit]
Description=Airtest airweb（流程执行器 HTTP 8123）
After=network-online.target airtest-timesync.service
Wants=network-online.target airtest-timesync.service
Before=airtest-usbwatch.service

StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/root/.openclaw/workspace/Airtest
ExecStart=/root/.openclaw/workspace/Airtest/.venv/bin/python ./airweb.py 8123
Restart=always
RestartSec=5
Environment=ANDROID_HOME=/usr/lib/android-sdk
Environment=PATH=/usr/lib/android-sdk/platform-tools:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
StandardOutput=append:/root/.openclaw/workspace/Airtest/logs/airweb.log
StandardError=append:/root/.openclaw/workspace/Airtest/logs/airweb.log

[Install]
WantedBy=multi-user.target
