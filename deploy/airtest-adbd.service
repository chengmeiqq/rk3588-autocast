[Unit]
Description=Airtest adb 连接守护（USB 优先，断了自动走 WiFi）
After=network-online.target
Wants=network-online.target

StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/root/.openclaw/workspace/Airtest
ExecStart=/root/.openclaw/workspace/Airtest/.venv/bin/python ./adbd.py
Restart=always
RestartSec=5
Environment=ANDROID_HOME=/usr/lib/android-sdk
Environment=PATH=/usr/lib/android-sdk/platform-tools:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
StandardOutput=append:/root/.openclaw/workspace/Airtest/logs/adbd.log
StandardError=append:/root/.openclaw/workspace/Airtest/logs/adbd.log

[Install]
WantedBy=multi-user.target
